# AMS environment template.
#
# Copy to `.env` and adjust. Local `docker compose` deployments consume it via
# `env_file: .env` (see docs/deployment/docker.md); from-source runs read the
# same variables from the shell. Values below are the code defaults —
# uncomment a line only to change it.
#
# Compose users: the MCP service needs docker-network values, not localhost —
# see the notes on AMS_API_URL, AMS_QMD_URL and AMS_MCP_HOST, and the complete
# reference table in docs/deployment/docker.md.

# ---------------------------------------------------------------------------
# Vault & Write API (packages/api)
# ---------------------------------------------------------------------------

# Absolute or relative path to the vault root (required for the Write API;
# the Docker image bakes in /data/vault).
#AMS_VAULT_PATH=./vault

# TCP port the Write API HTTP server binds.
#AMS_API_PORT=3000

# Write-lock time-to-live in milliseconds. A lock older than this is
# force-released, so a crashed writer cannot deadlock a note forever.
#AMS_LOCK_TTL_MS=5000

# ---------------------------------------------------------------------------
# Indexing & QMD retrieval (packages/api scheduler + @ams/shared adapter)
# ---------------------------------------------------------------------------

# node-cron expression for the reindex scheduler (default: every 2 minutes).
#AMS_INDEX_CRON=*/2 * * * *

# Master kill-switch for the scheduler: "false" starts it without scheduling
# anything (useful for tests or read-only replicas).
#AMS_INDEX_ENABLED=true

# Scope `qmd update`/`qmd embed` to one registered collection name. Unset
# reindexes every registered collection (QMD's default).
#AMS_QMD_COLLECTION=ams

# Path to the QMD CLI binary the reindexer shells out to.
#AMS_QMD_BIN=qmd

# Base URL of the QMD search daemon. Default suits from-source runs; in
# docker compose use http://ams:8181.
#AMS_QMD_URL=http://localhost:8181

# ---------------------------------------------------------------------------
# MCP server (packages/mcp — stdio and Streamable HTTP)
# ---------------------------------------------------------------------------

# Write API base URL the MCP tools call (required for both transports).
# Default suits from-source runs; in docker compose use http://ams:3000.
#AMS_API_URL=http://localhost:3000

# TCP port for the Streamable HTTP listener (HTTP transport only).
#AMS_MCP_PORT=3111

# Bind address for the Streamable HTTP listener. Loopback by default; set
# 0.0.0.0 inside a container and let the port mapping control exposure.
#AMS_MCP_HOST=127.0.0.1

# Static bearer token for POST /mcp (required in HTTP mode; stdio ignores
# it). Must match [A-Za-z0-9._~+/-]+=* — `openssl rand -base64 32` qualifies.
AMS_MCP_TOKEN=change-me

# OAuth 2.1 resource-server triple — all three set together or none.
# Unset keeps static-token-only auth. See docs/deployment/mcp-remote.md.
#AMS_MCP_OAUTH_ISSUER=https://your-tenant.auth0.com/
#AMS_MCP_OAUTH_AUDIENCE=https://your-domain.example.com/mcp
#AMS_MCP_PUBLIC_URL=https://your-domain.example.com

# Max requests per minute per client key on POST /mcp; 0 disables the
# in-app limiter (the first 429 layer is auth-free throttling).
#AMS_MCP_RATE_LIMIT=120

# ---------------------------------------------------------------------------
# Docker image internals (read by the container boot script, not by TS code)
# ---------------------------------------------------------------------------

# Port the QMD daemon and its IPv4 socat bridge bind inside the container.
#QMD_PORT=8181

# Directory holding the .qmd project registry on the /data volume.
#QMD_PROJECT_DIR=/data/qmd
