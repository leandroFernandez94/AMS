{
  "name": "ams",
  "version": "0.0.0",
  "private": true,
  "description": "Agents Memory System — shared memory architecture for AI agents, Markdown-first.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "typecheck": "tsc --build",
    "build": "tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "tracer": "node e2e/precheck.mjs && vitest run --config vitest.tracer.config.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@hono/node-server": "^2.0.6",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@types/node": "^26.0.1",
    "husky": "^9.1.7",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
